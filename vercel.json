{
  "crons": [
    {
      "path": "/api/cron-indexnow",
      "schedule": "0 0 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.raizon-okinawa.com"
        }
      ],
      "destination": "https://raizon-okinawa.com/$1",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/blog-list.html",
      "destination": "/blog-list",
      "permanent": true
    },
    {
      "source": "/blog-post.html",
      "destination": "/blog-post",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/blog/:id",
      "destination": "/api/blog-post?id=:id"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/blog-post",
      "destination": "/api/blog-post"
    },
    {
      "source": "/blog-list",
      "destination": "/api/blog-list"
    },
    {
      "source": "/line",
      "destination": "/line.html"
    },
    {
      "source": "/links",
      "destination": "/links.html"
    }
  ]
}
