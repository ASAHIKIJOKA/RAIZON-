{
  "crons": [
    {
      "path": "/api/cron-indexnow",
      "schedule": "0 0 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.raizon-okinawa.com"
        }
      ],
      "destination": "https://raizon-okinawa.com/$1",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/blog-list.html",
      "destination": "/blog-list",
      "permanent": true
    },
    {
      "source": "/blog-post.html",
      "destination": "/blog-post",
      "permanent": true
    },
    {
      "source": "/service.html",
      "destination": "/#service",
      "permanent": true
    },
    {
      "source": "/pricing.html",
      "destination": "/#price",
      "permanent": true
    },
    {
      "source": "/cases.html",
      "destination": "/#case",
      "permanent": true
    },
    {
      "source": "/company.html",
      "destination": "/#company",
      "permanent": true
    },
    {
      "source": "/contact.html",
      "destination": "/#contact",
      "permanent": true
    },
    {
      "source": "/faq.html",
      "destination": "/#faq",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/blog/:id",
      "destination": "/api/blog-post?id=:id"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/blog-post",
      "destination": "/api/blog-post"
    },
    {
      "source": "/blog-list",
      "destination": "/api/blog-list"
    },
    {
      "source": "/line",
      "destination": "/line.html"
    },
    {
      "source": "/links",
      "destination": "/links.html"
    },
    {
      "source": "/consult",
      "destination": "/consult.html"
    },
    {
      "source": "/web",
      "destination": "/web.html"
    },
    {
      "source": "/system",
      "destination": "/system.html"
    },
    {
      "source": "/apply",
      "destination": "/apply.html"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    },
    {
      "source": "/ai",
      "destination": "/v4/ai.html"
    },
    {
      "source": "/price",
      "destination": "/v4/price.html"
    },
    {
      "source": "/cases",
      "destination": "/v4/cases.html"
    },
    {
      "source": "/flow",
      "destination": "/v4/flow.html"
    },
    {
      "source": "/company",
      "destination": "/v4/company.html"
    },
    {
      "source": "/faq",
      "destination": "/v4/faq.html"
    },
    {
      "source": "/contact",
      "destination": "/v4/contact.html"
    }
  ],
  "headers": [
    {
      "source": "/legal/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/assets-line/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ]
}
